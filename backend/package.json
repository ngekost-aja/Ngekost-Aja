{
	"name": "ngekost-aja-backend",
	"version": "1.0.0",
	"description": "",
	"type": "module",
	"main": "src/server.ts",
	"scripts": {
		"tsoa:spec": "tsoa spec",
		"tsoa:routes": "tsoa routes",
		"tsoa:build": "pnpm tsoa spec && pnpm tsoa routes",
		"dev": "pnpm tsoa:build && nodemon --exec tsx ./src/server.ts",
		"build": "pnpm tsoa:build && tsc",
		"start": "node dist/server.js",
		"start:prod": "pnpm build && pnpm start"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@10.18.2",
	"dependencies": {
		"@prisma/adapter-mariadb": "^7.2.0",
		"@prisma/client": "^7.2.0",
		"@tsoa/runtime": "^6.6.0",
		"@types/swagger-ui-express": "^4.1.8",
		"bcrypt": "^6.0.0",
		"cors": "^2.8.5",
		"dotenv": "^17.2.3",
		"express": "^5.1.0",
		"jsonwebtoken": "^9.0.2",
		"swagger-ui-express": "^5.0.1",
		"tsoa": "^6.6.0"
	},
	"devDependencies": {
		"@types/bcrypt": "^6.0.0",
		"@types/body-parser": "^1.19.6",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.5",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^24.9.2",
		"nodemon": "^3.1.10",
		"prisma": "^7.2.0",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	},
	"watch": [
		"src"
	],
	"ext": "ts,json",
	"ignore": [
		"src/**/*.spec.ts",
		"node_modules"
	],
	"exec": "ts-node ./src/server.ts",
	"env": {
		"NODE_ENV": "development"
	}
}