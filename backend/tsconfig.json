{
	"compilerOptions": {
		"target": "ES2020",
		"module": "esnext",
		"lib": [
			"ES2020"
		],
		"moduleResolution": "node",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"outDir": "./dist",
		"baseUrl": "./src",
		"paths": {
			"@/*": [
				"./*"
			]
		},
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true
	},
	"include": [
		"src/**/*",
		"test/**/*"
	],
	"exclude": [
		"node_modules",
		"dist",
		"**/*.spec.ts"
	]
}