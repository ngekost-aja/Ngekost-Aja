{
	"entryFile": "src/server.ts",
	"noImplicitAdditionalProperties": "throw-on-extras",
	"controllerPathGlobs": [
		"src/modules/**/*.controller.ts"
	],
	"spec": {
		"outputDirectory": "src/docs",
		"specVersion": 3
	},
	"routes": {
		"routesDir": "src/routes"
	},
	"compilerOptions": {
		"baseUrl": "src",
		"paths": {
			"@/*": [
				"*"
			]
		}
	}
}